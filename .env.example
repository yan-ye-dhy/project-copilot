# Optional for D1: the application starts with defaults when .env is absent.
PROJECT_COPILOT_APP_NAME=Project Copilot
PROJECT_COPILOT_ENVIRONMENT=development

# Optional until an Embedding client is used. Put the real key only in local .env.
PROJECT_COPILOT_ZHIPU_API_KEY=
PROJECT_COPILOT_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
PROJECT_COPILOT_EMBEDDING_MODEL=embedding-3
# Local expected dimension; confirmed by a real smoke before Qdrant integration.
PROJECT_COPILOT_EMBEDDING_EXPECTED_DIMENSIONS=2048
PROJECT_COPILOT_EMBEDDING_BATCH_SIZE=64
PROJECT_COPILOT_ZHIPU_TIMEOUT_SECONDS=20

# D4: isolated Dense-only Qdrant; the application does not connect on import.
PROJECT_COPILOT_QDRANT_URL=http://127.0.0.1:6433
PROJECT_COPILOT_QDRANT_COLLECTION_NAME=pc_knowledge_dense_v0
PROJECT_COPILOT_QDRANT_TIMEOUT_SECONDS=10
PROJECT_COPILOT_RAG_TOP_K=5
# By default, successful document manifests live in this project's data/manifests.
# PROJECT_COPILOT_MANIFEST_DIR=/absolute/path/to/project-copilot/data/manifests
