# Reuse the existing CPU dependency image without a Docker Hub pull or install.
# Only for this source-only change; dependency changes need the normal Dockerfile.
FROM project-copilot-api:public-demo
WORKDIR /app
COPY --chown=1000:1000 src/ src/
COPY --chown=1000:1000 scripts/ scripts/
COPY --chown=1000:1000 migrations/ migrations/
# Release admission binds these reviewed entry files to the same source tree.
COPY --chown=1000:1000 cloud-functions/ cloud-functions/
COPY --chown=1000:1000 edgeone.json docker-compose.public-demo.yml ./
COPY --chown=1000:1000 deploy/nginx/ deploy/nginx/
