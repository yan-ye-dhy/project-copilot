# 示例仅用于后续部署准备：当前公网硬闸关闭，不要启动隧道。
# 复制为 .env.public-demo 后仅在本机填写；该文件被 .gitignore 排除。
PROJECT_COPILOT_PUBLIC_POSTGRES_PASSWORD=
# URL 的用户名/数据库必须为 project_copilot_public，密码须与上面一致并按 URL 编码。
PROJECT_COPILOT_DATABASE_URL=
# 随机代理密钥，仅限 32–128 位 base64url 字符；后端与 EdgeOne 服务端必须一致。
PROJECT_COPILOT_PUBLIC_PROXY_SECRET=
# 站点实际 HTTPS origin；不带路径、查询或尾部业务路径。
PROJECT_COPILOT_AUTH_PUBLIC_ORIGIN=
PROJECT_COPILOT_DEEPSEEK_API_KEY=
PROJECT_COPILOT_ZHIPU_API_KEY=
PROJECT_COPILOT_AUTH_OPEN_REGISTRATION=false
PROJECT_COPILOT_MAX_DAILY_REQUESTS_PER_USER=5
PROJECT_COPILOT_MAX_DAILY_REQUESTS_GLOBAL=30
PROJECT_COPILOT_MAX_CONCURRENT_REQUESTS_PER_USER=1
PROJECT_COPILOT_MAX_PROVIDER_ATTEMPTS_PER_JOB=16
# PERSONAL_DEMO only: separate validated limits, captured by a fresh admin grant.
# These do not raise STAGING/PUBLIC limits above. Do not overwrite a private env file.
PROJECT_COPILOT_PERSONAL_MAX_DAILY_REQUESTS_PER_USER=1000
PROJECT_COPILOT_PERSONAL_MAX_DAILY_REQUESTS_GLOBAL=2000
PROJECT_COPILOT_PERSONAL_MAX_CONCURRENT_REQUESTS_PER_USER=3
PROJECT_COPILOT_PERSONAL_MAX_PROVIDER_ATTEMPTS_PER_JOB=160
PROJECT_COPILOT_PERSONAL_AGENT_MAX_MODEL_CALLS=24
PROJECT_COPILOT_PERSONAL_AGENT_MAX_TOOL_CALLS=80
PROJECT_COPILOT_PERSONAL_AGENT_TOOL_TIMEOUT_SECONDS=300
PROJECT_COPILOT_PERSONAL_AGENT_MODEL_TIMEOUT_SECONDS=60
PROJECT_COPILOT_PERSONAL_AGENT_TOTAL_TIMEOUT_SECONDS=900
PROJECT_COPILOT_PERSONAL_DEEPSEEK_MAX_TOKENS=4096
PROJECT_COPILOT_PERSONAL_CONTEXT_HOURLY_LIMIT=100
PROJECT_COPILOT_PERSONAL_CONTEXT_ACTIVE_LIMIT=30
PROJECT_COPILOT_PERSONAL_PROPOSAL_DAILY_LIMIT=200
PROJECT_COPILOT_PERSONAL_PROPOSAL_PENDING_LIMIT=30
PROJECT_COPILOT_PUBLIC_JOB_QUEUE_TTL_SECONDS=86400
PROJECT_COPILOT_PUBLIC_UPLOAD_MAX_CHUNKS=64
PROJECT_COPILOT_PUBLIC_UPLOAD_MAX_CHARS=32000
PROJECT_COPILOT_TRACING_ENABLED=false
# 现有 BGE 缓存只读挂载；绝不把模型权重提交 Git。
PROJECT_COPILOT_MODEL_CACHE_HOST_DIR=./models/huggingface
# 私有发布验收工件目录，只读挂到/app/release；用户先mkdir并chmod 700。
PROJECT_COPILOT_RELEASE_EVIDENCE_HOST_DIR=./data/release-evidence
